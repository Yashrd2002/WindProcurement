# Browser-visible API base URL. Leave blank when frontend and API share one origin.
VITE_API_BASE_URL=http://localhost:8000

# Backend settings
APP_NAME=Wind Procurement Intelligence API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=3600
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# AI Copilot settings (Optional: enables live OpenAI GPT-4o-mini trading desk analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
